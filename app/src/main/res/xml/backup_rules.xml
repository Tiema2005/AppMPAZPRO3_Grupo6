<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Excluir todos los archivos privados -->
    <exclude
        domain="root"
        path="./" />
    <!-- Excluir almacenamiento protegido por dispositivo -->
    <exclude
        domain="device_root"
        path="./" />
    <!-- Excluir archivos externos privados de la aplicación -->
    <exclude
        domain="external"
        path="./" />
</full-backup-content>